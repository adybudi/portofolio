# Defense in depth for files served through the /storage symlink.
<FilesMatch "\.(?i:php|php3|php4|php5|php7|php8|phps|phtml|phar|inc|sh|bash|cgi|pl|py|rb|exe|htm|html|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phps .phtml .phar .cgi .pl .py .rb .sh .bash
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phps .phtml .phar .cgi .pl .py .rb .sh .bash
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
